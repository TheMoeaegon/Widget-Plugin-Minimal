{
  "$schema": "http://json.schemastore.org/template",
  "author": "TheMoeaegon",
  "classifications": [ "NopCommerce", "Plugin", "Widget" ],
  "identity": "NopCommerce.Plugin.Widget.Minimal",
  "name": "NopCommerce Widget Plugin Minimal",
  "shortName": "nop-plugin-minimal",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "PluginName",
  "preferNameDirectory": true,
  "defaultName": "Nop.Plugin.Widgets.PluginName",
  "symbols": {
    "PluginName": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "PluginName",
      "fileRename": "PluginName"
    }
  }
}
